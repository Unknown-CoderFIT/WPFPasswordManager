<Window x:Class="PasswordManager.Views.PasswordCreation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Title="Портативный менеджер паролей(создание)" Height="862" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#3D3D3D">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кнопка "Назад" в левом верхнем углу -->
        <Button x:Name="BackButton"
        Grid.Row="0"
        Content="Назад"
        FontSize="14"
        Padding="15,8"
        Cursor="Hand"
        Click="BackButton_Click"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="0,0,0,20"
        Background="#1976D2"
        Foreground="Black"
        BorderBrush="Black"
        BorderThickness="2">
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1E88E5"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Button.Style>
        </Button>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="#2E7D32"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="10"
                Padding="20"
                Margin="0,40,0,40"
                HorizontalAlignment="Center"
                Width="500">
            <TextBlock Text="Придумайте пароль"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Поле "Название:" -->
        <StackPanel Grid.Row="1" Margin="0,10,0,15" HorizontalAlignment="Center" Width="500">
            <TextBlock Text="Название сервиса:"
                       FontSize="16"
                       Foreground="White"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="ServiceNameInput"
                     FontSize="18"
                     Background="Transparent"
                     Foreground="White"
                     CaretBrush="White"
                     BorderThickness="0,0,0,2"
                     BorderBrush="Black"
                     Padding="5"/>
        </StackPanel>

        <!-- Поле "Логин:" -->
        <StackPanel Grid.Row="2" Margin="0,30,0,20" HorizontalAlignment="Center" Width="500">
            <TextBlock Text="Логин:"
                       FontSize="16"
                       Foreground="White"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="LoginInput"
                     FontSize="18"
                     Background="Transparent"
                     Foreground="White"
                     CaretBrush="White"
                     BorderThickness="0,0,0,2"
                     BorderBrush="Black"
                     Padding="5"
                     TextChanged="LoginInput_TextChanged"/>
        </StackPanel>

        <!-- Поле "Пароль:" + кнопка "Сгенерировать" -->
        <Grid Grid.Row="3" Margin="0,20" HorizontalAlignment="Center" Width="500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Пароль:"
                           FontSize="16"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="PasswordInput"
                         FontSize="18"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0,0,0,2"
                         BorderBrush="Black"
                         Padding="5"
                         TextChanged="PasswordInput_TextChanged"/>
            </StackPanel>

            <Button x:Name="GenerateButton"
                    Grid.Column="1"
                    Content="Сгенерировать"
                    FontSize="14"
                    Padding="15,8"
                    Cursor="Hand"
                    Click="GenerateButton_Click"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,5">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#1976D2"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter x:Name="contentPresenter"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1E88E5"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="#0D47A1"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Критерии (2x2 сетка) -->
        <Grid Grid.Row="4" Margin="0,30" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Критерий 1: Длина -->
            <Border x:Name="CriterionLength"
                    Grid.Row="0" Grid.Column="0"
                    Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2">
                <TextBlock Text="От 12 и более символов"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Критерий 2: Спец. символы -->
            <Border x:Name="CriterionSpecial"
                    Grid.Row="0" Grid.Column="2"
                    Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2">
                <TextBlock Text="Должны быть спец. символы (!, № и прочее)"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Критерий 3: Цифра -->
            <Border x:Name="CriterionDigit"
                    Grid.Row="2" Grid.Column="0"
                    Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2">
                <TextBlock Text="Должна быть хоть одна цифра"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Критерий 4: Верхний регистр -->
            <Border x:Name="CriterionUpper"
                    Grid.Row="2" Grid.Column="2"
                    Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2">
                <TextBlock Text="Хотя бы одна буква в верхнем регистре"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Пустое пространство -->
        <Grid Grid.Row="5"/>

        <!-- Кнопка "Сохранить пароль" -->
        <Button x:Name="SaveButton"
                Grid.Row="6"
                Content="Сохранить пароль"
                FontSize="18"
                Padding="12,20"
                Cursor="Hand"
                Click="SaveButton_Click"
                IsEnabled="False"
                HorizontalAlignment="Center"
                Width="300"
                Margin="0,40">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#757575"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="contentPresenter"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E88E5"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#0D47A1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                                        <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter Property="Background" Value="#1976D2"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>