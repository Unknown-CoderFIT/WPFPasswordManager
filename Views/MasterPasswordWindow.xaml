<Window x:Class="PasswordManager.Views.MasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.Views"
        mc:Ignorable="d"
        Closed="Window_Closed"
        Title="Портативный менеджер паролей" Height="862" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#3D3D3D">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="#2E7D32"
                BorderBrush="Black"
                BorderThickness="2"
                Padding="20"
                Margin="0,20,0,40">
            <TextBlock Text="Придумайте мастер-пароль"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Поле ввода -->
        <StackPanel Grid.Row="1" Margin="0,20">
            <TextBlock Text="Введите пароль:"
                       FontSize="16"
                       Foreground="White"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="PasswordInput"
                     FontSize="18"
                     Background="Transparent"
                     Foreground="White"
                     CaretBrush="White"
                     BorderThickness="0,0,0,2"
                     BorderBrush="Black"
                     Padding="5"
                     TextChanged="PasswordInput_TextChanged"/>
        </StackPanel>

        <!-- Критерии -->
        <StackPanel Grid.Row="2"
                    Margin="0,30"
                    HorizontalAlignment="Center">

            <Border x:Name="CriterionLength"
                    Width="400" Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2"
                    Margin="0,8">
                <TextBlock Text="От 12 и более символов"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        <Border x:Name="CriterionDigit"
                    Width="400" Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2"
                    Margin="0,8">
                <TextBlock Text="Должна быть хоть одна цифра"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <Border x:Name="CriterionSpecial"
                    Width="400" Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2"
                    Margin="0,8">
                <TextBlock Text="Должны быть спец. символы (!, № и прочее)"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <Border x:Name="CriterionUpper"
                    Width="400" Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2"
                    Margin="0,8">
                <TextBlock Text="Хотя бы одна буква в верхнем регистре"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <Border x:Name="CriterionLower"
                    Width="400" Height="40"
                    CornerRadius="10"
                    BorderBrush="#D32F2F"
                    BorderThickness="2"
                    Margin="0,8">
                <TextBlock Text="Хотя бы одна буква в нижнем регистре"
                           FontSize="14"
                           Foreground="#D32F2F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Кнопка создания -->
        <Button x:Name="CreateButton"
                Grid.Row="4"
                Content="Создать мастер-пароль"
                FontSize="18"
                Padding="20,12"
                IsEnabled="False"
                Cursor="Hand"
                Click="CreateButton_Click"
                HorizontalAlignment="Center">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#757575"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="20"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                <!-- Наведение мыши -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1B5E20"/>
                                </Trigger>
                                <!-- Нажатие кнопки -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1B5E20"/>
                                </Trigger>
                                <!-- Неактивная кнопка -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter Property="Background" Value="#2E7D32"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>